{
  "exe": "<STRATA_ROOT>/engine/strata",
  "args": [
    "--pack",
    "<MODEL_DATA>/packs/swift-iq3_xxs",
    "--native",
    "<MODEL_DATA>/models/swift-IQ3_XXS/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
    "--ple-gguf",
    "<MODEL_DATA>/models/swift-IQ3_XXS/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
    "--expert-profile",
    "<STRATA_ROOT>/data/expert-profile.bin",
    "--mtp",
    "<MODEL_DATA>/mtp/rt",
    "--max-context",
    "1048576",
    "--expert-cache",
    "auto",
    "--prefill",
    "auto",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--kv",
    "int8",
    "--kv-resident",
    "32768",
    "--vram-reserve-mib",
    "1500",
    "--rope-scaling",
    "yarn",
    "--rope-scale",
    "4.0",
    "--yarn-orig-ctx",
    "262144",
    "--vision"
  ],
  "cwd": "<STRATA_ROOT>",
  "tokenizer": "<MODEL_DATA>/packs/swift-iq3_xxs/tokenizer",
  "model_name": "hermes-brain",
  "gpu": 0,
  "gpus_asked": true,
  "host": "127.0.0.1",
  "port": 18089,
  "lib_dirs": [
    "/opt/cuda/lib64",
    "/opt/MonitorSoftware/lib",
    "/usr/sfw/lib",
    "/usr/local/lib"
  ],
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20
  },
  "vision": {
    "exe": "<STRATA_ROOT>/engine/strata-vision",
    "mmproj": "<MODEL_DATA>/models/mmproj-Swift-Qwen3.8-Flash-Next-BF16.gguf",
    "model": "<MODEL_DATA>/models/swift-IQ3_XXS/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
    "gpu": true,
    "max_tokens": 1024
  },
  "slot_save_path": "<NVME_SLOT_DIR>"
}
