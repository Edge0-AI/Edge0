{
  "engine": "strata",
  "exe": "$STRATA_ROOT/build-sycl/strata",
  "args": [
    "--pack",
    "$PACK_DIR",
    "--native",
    "$MODEL_DIR/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00001-of-00002.gguf",
    "--ple-gguf",
    "$MODEL_DIR/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00002-of-00002.gguf",
    "--expert-profile",
    "$EXPERT_PROFILE",
    "--expert-cache",
    "auto",
    "--stream-experts",
    "--pcie-frac",
    "1",
    "--prefill",
    "4096",
    "--spec",
    "4",
    "--mtp-max-t",
    "4",
    "--suffix-draft",
    "0",
    "--mtp",
    "$MTP_DIR",
    "--max-context",
    "8192",
    "--kv",
    "int8",
    "--vram-reserve-mib",
    "3072",
    "--adapt-every",
    "0",
    "--adapt-swaps",
    "0",
    "--pool-workers",
    "4",
    "--prompt-cache",
    "0",
    "--prompt-cache-every",
    "0",
    "--conversation-cache-mib",
    "0",
    "--short-read",
    "0",
    "--spec-min-p",
    "0.5"
  ],
  "cwd": "$STRATA_ROOT",
  "tokenizer": "$PACK_DIR/tokenizer",
  "model_name": "qwen3.8-flash-next-strata-iq2-xs-8k",
  "backend": "sycl",
  "host": "127.0.0.1",
  "parallel": 1,
  "api_monitor": false,
  "open_browser": false,
  "sampling": {
    "temperature": 0.0,
    "seed": 17
  },
  "engine_silence_s": 180,
  "cors_origins": [],
  "allowed_hosts": [
    "127.0.0.1",
    "localhost"
  ]
}
