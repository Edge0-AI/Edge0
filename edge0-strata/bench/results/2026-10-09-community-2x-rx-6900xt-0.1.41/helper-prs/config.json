{
  "exe": "/work/prs/strata-engine",
  "args": [
    "--pack",
    "/m/packs/iq3_s",
    "--native",
    "/m/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "--ple-gguf",
    "/m/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00002-of-00002.gguf",
    "--expert-profile",
    "/work/prs/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "auto",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "/m/mtp/rt",
    "--max-context",
    "131072",
    "--kv",
    "int8",
    "--kv-resident",
    "32768",
    "--expert-cache-device1",
    "auto",
    "--remote-expert-opt",
    "--ple-io",
    "ram"
  ],
  "cwd": "/work/prs",
  "tokenizer": "/m/packs/iq3_s/tokenizer",
  "model_name": "strata-helper",
  "log": "/bench/helper-prs/engine.log",
  "lib_dirs": [
    "/opt/rocm/lib"
  ],
  "port": 8080,
  "backend": "hip",
  "gpu": 1,
  "gpus_asked": true,
  "env": {
    "HIP_VISIBLE_DEVICES": "1,0",
    "STRATA_HIP_PROMPT_F16": "1",
    "STRATA_SH_STREAM": "1",
    "STRATA_ROCBLAS_TUNING": "/work/prs/tools/hip",
    "STRATA_TUNING_CACHE": "/home/user/.cache/strata",
    "STRATA_SELECT_SGEMM": "1",
    "STRATA_SELECT_SGEMM_VERBOSE": "1",
    "STRATA_IO_THREADS": "128",
    "STRATA_PREFILL_CPU_SHARE": "auto",
    "STRATA_HIP_ADAPT_KERNEL_COPY": "1"
  }
}