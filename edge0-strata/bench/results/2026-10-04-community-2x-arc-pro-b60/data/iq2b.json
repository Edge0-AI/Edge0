{
 "engine": "strata",
 "exe": "<data root>/strata-native.sh",
 "cwd": "<strata checkout>",
 "tokenizer": "<data root>/packs/qwen-iq2_xs/tokenizer",
 "model_name": "qwen3.8-flash-next-iq2_xs",
 "backend": "sycl",
 "log": "<data root>/logs/w2/iq2b.engine.log",
 "args": [
  "--pack",
  "<data root>/packs/qwen-iq2_xs",
  "--native",
  "<data root>/models/qwen-iq2_xs/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00001-of-00002.gguf",
  "--ple-gguf",
  "<data root>/models/qwen-iq2_xs/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00002-of-00002.gguf",
  "--expert-profile",
  "data/expert-profile.bin",
  "--expert-cache",
  "auto",
  "--stream-experts",
  "--prefill",
  "auto",
  "--spec",
  "4",
  "--spec-min-p",
  "0.5",
  "--mtp",
  "<data root>/mtp/rt",
  "--max-context",
  "8192",
  "--kv",
  "int8",
  "--vram-reserve-mib",
  "1536",
  "--no-prefill-borrow",
  "--layer-split",
  "25"
 ],
 "env": {
  "ONEAPI_DEVICE_SELECTOR": "level_zero:0,1",
  "SYCL_CACHE_PERSISTENT": "0",
  "STRATA_MIRROR_MIB": "6144",
  "STRATA_VERIFY_DEVICE_PLAN": "1",
  "STRATA_STAGE_TRIM": "1",
  "STRATA_VERIFY_NO_HOST": "1"
 }
}