 1 file changed, 4 insertions(+)

diff --git a/ggml/src/ggml-cpu/moe_pool.c b/ggml/src/ggml-cpu/moe_pool.c
index 903f0f7..4d62904 100644
--- a/ggml/src/ggml-cpu/moe_pool.c
+++ b/ggml/src/ggml-cpu/moe_pool.c
@@ -466,6 +466,10 @@ static void water_trim_locked(void) {
     if (!fe) return;
     const long long floor_mb = atoll(fe);
     if (floor_mb <= 0) return;
+    static uint64_t s_next = 0;                        // 2s throttle (third-audit case: opening /proc on every ensure cost a ~3% measurement tax)
+    const uint64_t now = now_ns();
+    if (now < s_next) return;
+    s_next = now + 2000000000ull;
     const long long avail = mem_avail_mb();
     if (avail < 0 || avail >= floor_mb) return;
     const int target = (int) (g_nslots * 6 / 10);
