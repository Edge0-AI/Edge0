 1 file changed, 2 insertions(+)

diff --git a/ggml/src/ggml-cpu/moe_pool.c b/ggml/src/ggml-cpu/moe_pool.c
index 2098376..9bd55dc 100644
--- a/ggml/src/ggml-cpu/moe_pool.c
+++ b/ggml/src/ggml-cpu/moe_pool.c
@@ -706,6 +706,7 @@ void moe_pool_keepwarm(int budget_mb) {
     pthread_mutex_lock(&g_lock);
     unsigned seen_end = g_kwh;
     for (unsigned i = g_kwt; i < seen_end && bytes > 0; i++) {
+        if (!g_ready) break;                                   // stop immediately if reset came in midway
         int k = i % KW_DEPTH;
         const int tix = g_kw[k].tix; const int32_t e2 = g_kw[k].e;
         if (tix < 0 || tix >= g_ntp) continue;
@@ -769,6 +770,7 @@ void moe_pool_extra(long long * stall_ns, long long * slots_used, long long * sl
 // cross-model-switch reset (insurance against the 9/29 crash-family incident): called by nativeFree. After waiting for the IO
 // drain, all state is zeroed; the next moe_pool_init/register rebuilds under the new env. Head mappings are kept (those files don't change with the model).
 void moe_pool_reset_all(void) {
+    for (int w = 0; w < 200 && g_kw_busy; w++) usleep(10000);   // keepwarm in-flight hard gate (prevents the UAF race)
     pthread_mutex_lock(&g_lock);
     while (g_inflight > 0) pthread_cond_wait(&g_scv, &g_lock);       // wait for in-flight reads to terminate
     for (int i = 0; i < g_ntp; i++) { free(g_tp[i].slot); g_tp[i].slot = NULL; }
