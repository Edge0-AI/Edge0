--- a/ggml/src/ggml-cpu/moe_pool.c
+++ b/ggml/src/ggml-cpu/moe_pool.c
@@ -719,6 +719,33 @@ void moe_pool_extra(long long * stall_ns, long long * slots_used, long long * sl
     if (pf_mispredict) *pf_mispredict = g_pf_miss;
 }
 
+// cross-model-switch reset (insurance against the 9/29 crash-family incident): called by nativeFree. After waiting for the IO
+// drain, all state is zeroed; the next moe_pool_init/register rebuilds under the new env. Head mappings are kept (those files don't change with the model).
+void moe_pool_reset_all(void) {
+    pthread_mutex_lock(&g_lock);
+    while (g_inflight > 0) pthread_cond_wait(&g_scv, &g_lock);       // wait for in-flight reads to terminate
+    for (int i = 0; i < g_ntp; i++) { free(g_tp[i].slot); g_tp[i].slot = NULL; }
+    g_ntp = 0;
+    for (int i = 0; i < 64; i++) { g_lr[i].tix[0] = g_lr[i].tix[1] = g_lr[i].tix[2] = -1; }
+    if (g_slots) {
+        for (int i = 0; i < g_nslots; i++) {
+            struct slot_ent * sl = &g_slots[i];
+            if (sl->on_list) list_unlink(i);
+            sl->state = ST_EMPTY; sl->expert = -1; sl->tix = -1; sl->pinned = 0;
+            sl->prefetched = 0; sl->consumed = 0;
+        }
+        free(g_slots); g_slots = NULL;
+    }
+    if (g_arena) { munmap(g_arena, g_slice * (size_t) g_nslots); g_arena = NULL; }
+    g_nslots = 0; g_used_slots = 0; g_empty_cursor = 0; g_slice = 0;
+    g_lru_head = g_lru_tail = SLOT_NONE;
+    g_qdn = g_qpn = 0; g_qph = g_qpt = g_qdh = g_qdt = 0;
+    if (g_blob) { madvise(g_blob, g_blob_cap, MADV_DONTNEED); g_blob_bump = 0; }
+    g_ready = 0; g_cap_bytes = 0;
+    g_npins = 0;
+    pthread_mutex_unlock(&g_lock);
+}
+
 __attribute__((destructor)) static void moe_pool_dump(void) {
     if (!g_ready && !g_blob_on) return;
     long long h = 0, m = 0;
diff --git a/ggml/src/ggml-cpu/moe_pool.h b/ggml/src/ggml-cpu/moe_pool.h
