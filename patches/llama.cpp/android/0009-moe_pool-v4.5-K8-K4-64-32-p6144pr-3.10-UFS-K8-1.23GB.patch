---
 ggml/src/ggml-cpu/moe_pool.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/ggml/src/ggml-cpu/moe_pool.c b/ggml/src/ggml-cpu/moe_pool.c
index 4d62904..7584680 100644
--- a/ggml/src/ggml-cpu/moe_pool.c
+++ b/ggml/src/ggml-cpu/moe_pool.c
@@ -270,16 +270,16 @@ static void pred_do_job(struct pred_job * j) {
         out[o] = dot_f16_f32(lin + (size_t) o * 2560, j->x, 2560)
                + dot_f16_f32(fc2 + (size_t) o * 512, h, 512);
     }
-    int top[8]; float tv[8]; for (int k = 0; k < 8; k++) { tv[k] = -1e30f; top[k] = -1; }
+    int top[4]; float tv[4]; for (int k = 0; k < 4; k++) { tv[k] = -1e30f; top[k] = -1; }
     for (int e = 0; e < 256; e++) {
-        for (int k = 0; k < 8; k++) {
+        for (int k = 0; k < 4; k++) {
             if (out[e] > tv[k]) {
-                for (int m = 7; m > k; m--) { tv[m] = tv[m-1]; top[m] = top[m-1]; }
+                for (int m = 3; m > k; m--) { tv[m] = tv[m-1]; top[m] = top[m-1]; }
                 tv[k] = out[e]; top[k] = e; break;
             }
         }
     }
-    for (int k = 0; k < 8; k++) {
+    for (int k = 0; k < 4; k++) {
         if (top[k] < 0) break;
         for (int role = 0; role < 3; role++) {
             const int64_t tix = g_lr[j->layer].tix[role];
@@ -667,7 +667,7 @@ void moe_pool_prefetch_impl(struct tensor_pool * p, int64_t e) {
         pthread_mutex_unlock(&g_lock);
         return;
     }
-    if (g_qpn > 64) { g_pf_drop++; pthread_mutex_unlock(&g_lock); return; }   // throttle: drop prefetches when the main queue backs up
+    if (g_qpn > 32) { g_pf_drop++; pthread_mutex_unlock(&g_lock); return; }   // throttle v4.5 (K8 backlash case: 64 still exceeded the device bandwidth)
     g_pf_issued++;
     const int32_t slot = claim_slot_locked(tix, (int32_t) e);
     if (slot < 0) { g_pf_drop++; pthread_mutex_unlock(&g_lock); return; }
