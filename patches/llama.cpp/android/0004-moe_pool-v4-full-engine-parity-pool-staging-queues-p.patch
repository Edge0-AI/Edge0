+static long long mem_avail_mb(void) {
+    FILE * f = fopen("/proc/meminfo", "r");
+    if (!f) return -1;
+    char ln[256]; long long v = -1;
+    while (fgets(ln, sizeof(ln), f)) {
+        if (!strncmp(ln, "MemAvailable:", 13)) { v = atoll(ln + 13) / 1024; break; }
+    }
+    fclose(f);
+    return v;
+}
+// watermark trim (simplified form of the engine's trim): evict only non-pinned READY; no physical frame reclaim (the arena middle is not contiguous -- see ALIGNMENT.md).
+static void water_trim_locked(void) {
+    const char * fe = getenv("E0_MEM_FLOOR_MB");
+    if (!fe) return;
+    const long long floor_mb = atoll(fe);
+    if (floor_mb <= 0) return;
+    const long long avail = mem_avail_mb();
+    if (avail < 0 || avail >= floor_mb) return;
+    const int target = (int) (g_nslots * 6 / 10);
+    int n = 0;
+    while (g_used_slots > target) {
+        int32_t v = SLOT_NONE;
+        for (int32_t i = g_lru_head; i != SLOT_NONE; ) {
+            int32_t nxt = g_slots[i].lru_next;
