+            i = nxt;
+        }
+        if (v < 0) break;
+        struct slot_ent * s = &g_slots[v];
+        g_tp[s->tix].slot[s->expert] = SLOT_NONE;
+        account_evict(s);
+        list_unlink(v);
+        s->state = ST_EMPTY; s->expert = -1;
+        g_used_slots--; g_trims++; n++;
+    }
+    if (n) fprintf(stderr, "moe_pool trim: evicted=%d used=%d MemAvailable=%lldMB\n", n, g_used_slots, avail);
+}
