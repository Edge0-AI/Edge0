+void * moe_pool_blob_add(size_t nbytes) {
+    if (!g_blob_on || !nbytes) return NULL;
+    const size_t need = (nbytes + 4095) & ~(size_t)4095;
+    if (g_blob_bump + need > g_blob_cap) return NULL;        // budget exhausted: this tensor stays in mmap (see dump for accounting)
+    void * p = g_blob + g_blob_bump;
+    g_blob_bump += need;
+    return p;
+}
+
+// ===================== v3 -> v4: predictive prefetch engine (advisory head; the pool is read-only and never touches logits) =====================
+// Math = PREROUTER_SPEC sec.2: logits = linear_init(x) + fc2(gelu_erf(fc1(x))),
+//   x = [m_in(2048) | cur_onehot(256) | prev_onehot(256)]; the top-K prediction set is used only for prefetch; routing remains teacher.
+#include <math.h>
+#define PRED_RINGSZ 128
+struct pred_job {
+    int      layer;
+    int      ntok;
+    float    x[2560];                    // feats: 0..2047 = m_in last-token row, 2048..2303 = cur_oh, 2304..2559 = prev_oh
+    int32_t  cur_ids[8];  int n_cur;
+    int32_t  prev_ids[8]; int n_prev;
+};
+static struct {
+    int      bound;
+    const struct ggml_tensor * min;
+    int64_t  tix[3];                     // g_tp indices of gate/up/down, filled back at registration
+    struct { const uint16_t * fc1, * fc2, * lin; } hd;
+    int32_t  prev_exec[8]; int n_prev;
+} g_lr[64];
+static struct pred_job g_ring[PRED_RINGSZ];
+static volatile int g_ring_head, g_ring_tail, g_worker_on;
+static char * g_headmap; static size_t g_headmap_sz;
+
+static void * pred_worker(void * arg);
+struct tensor_pool;
+void moe_pool_prefetch_impl(struct tensor_pool * p, int64_t e);
+
+int moe_pool_load_heads(const char * path) {
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) return 0;
+    size_t sz = (size_t) lseek(fd, 0, SEEK_END); lseek(fd, 0, SEEK_SET);
+    void * m = mmap(NULL, sz, PROT_READ, MAP_PRIVATE, fd, 0);
+    close(fd);
+    if (m == MAP_FAILED) return 0;
+    g_headmap = m; g_headmap_sz = sz;
+    uint32_t magic; memcpy(&magic, m, 4);
+    if (magic != 0x44483045u) return 0;
+    int n; memcpy(&n, (char *) m + 4, 4);
+    size_t off = 8;
+    for (int i = 0; i < n; i++) {
+        int layer; memcpy(&layer, (char *) m + off, 4); off += 4;
+        uint32_t l1, l2, l3;
+        memcpy(&l1, (char *) m + off, 4); memcpy(&l2, (char *) m + off + 4, 4); memcpy(&l3, (char *) m + off + 8, 4);
+        off += 12;
+        if (layer >= 0 && layer < 64) {
+            g_lr[layer].hd.fc1 = (const uint16_t *) ((char *) m + off);
+            g_lr[layer].hd.fc2 = (const uint16_t *) ((char *) m + off + l1);
+            g_lr[layer].hd.lin = (const uint16_t *) ((char *) m + off + l1 + l2);
+        }
+        off += (size_t) l1 + l2 + l3;
+    }
+    g_heads_on = 1;
+    g_pred_enabled = getenv("E0_PREROUTER") != NULL;
+    return 1;
+}
+
+void moe_pool_bind_min(int layer, const struct ggml_tensor * t) {
+    if (layer >= 0 && layer < 64) { g_lr[layer].min = t; g_lr[layer].bound = 1; }
+}
+
+void moe_pool_note_routing(const struct ggml_tensor * src0, const int32_t * ids, int n_ids) {
+    static int s_nr1;
+    if (getenv("E0_POOL_STATS") && !s_nr1) { s_nr1 = 1; fprintf(stderr, "moe_pool note#1: pred=%d heads=%d n_ids=%d name=%s\n", g_pred_enabled, g_heads_on, n_ids, src0->name); }
+    if (!g_pred_enabled || !g_heads_on || n_ids <= 0 || n_ids > 8) return;
+    int layer = -1; const char * q = strstr(src0->name, "blk.");
+    if (q) layer = (int) strtol(q + 4, NULL, 10);
+    if (layer < 0 || layer >= 64) return;
+    if (!g_lr[layer].bound || !g_lr[layer].min || !g_lr[layer].hd.fc1) return;
+    const struct ggml_tensor * min = g_lr[layer].min;
+    if (!min->data) return;
+    const int64_t n_embd = min->ne[0];
+    if (n_embd > 2048 || min->ne[1] < 1) return;
+    pthread_mutex_lock(&g_lock);
+    if (g_ring_head - g_ring_tail >= PRED_RINGSZ) { pthread_mutex_unlock(&g_lock); return; }  // backpressure: drop the prefetch
+    struct pred_job * j = &g_ring[g_ring_head % PRED_RINGSZ];
+    g_ring_head++;
+    j->layer = layer; j->n_cur = n_ids;
+    const float * row = (const float *) ((const char *) min->data + (min->ne[1] - 1) * min->nb[1]);
+    memcpy(j->x, row, (size_t) n_embd * sizeof(float));
+    memset(j->x + n_embd, 0, (2048 - (size_t) n_embd) * sizeof(float));
+    memset(&j->x[2048], 0, (2560 - 2048) * sizeof(float));
+    for (int i = 0; i < n_ids; i++) if (ids[i] >= 0 && ids[i] < 256) j->x[2048 + ids[i]] = 1.0f;
+    j->n_prev = g_lr[layer].n_prev;
+    for (int i = 0; i < j->n_prev; i++) {
+        const int32_t e = g_lr[layer].prev_exec[i];
+        if (e >= 0 && e < 256) j->x[2304 + e] = 1.0f;
+    }
+    memcpy(j->cur_ids, ids, (size_t) n_ids * sizeof(int32_t));
+    memcpy(g_lr[layer].prev_exec, ids, (size_t) n_ids * sizeof(int32_t));   // teacher facts go into prev
+    g_lr[layer].n_prev = n_ids;
+    if (!g_worker_on) {
+        g_worker_on = 1;
+        pthread_t th;
+        pthread_create(&th, NULL, pred_worker, NULL);
+        pthread_detach(th);
+    }
+    pthread_mutex_unlock(&g_lock);
+}
+
+static inline float f16tof(uint16_t h) {
+    const uint32_t w = (uint32_t) h << 16;
+    float f; memcpy(&f, &w, 4); return f;
+}
+static inline float gelu_erf_f(float x) { return 0.5f * x * (1.0f + erff(x * 0.70710678118654752440f)); }
+
+static void pred_do_job(struct pred_job * j) {
+    float h[512], out[256];
+    const uint16_t * fc1 = g_lr[j->layer].hd.fc1;
+    const uint16_t * fc2 = g_lr[j->layer].hd.fc2;
+    const uint16_t * lin = g_lr[j->layer].hd.lin;
+    for (int o = 0; o < 512; o++) {
+        const uint16_t * wrow = fc1 + (size_t) o * 2560;
+        float acc = 0;
+        for (int i = 0; i < 2560; i++) acc += f16tof(wrow[i]) * j->x[i];
+        h[o] = gelu_erf_f(acc);
+    }
+    for (int o = 0; o < 256; o++) {
+        const uint16_t * wr = lin + (size_t) o * 2560;
+        const uint16_t * wc = fc2 + (size_t) o * 512;
+        float acc = 0;
+        for (int i = 0; i < 2560; i++) acc += f16tof(wr[i]) * j->x[i];
+        for (int i = 0; i < 512; i++) acc += f16tof(wc[i]) * h[i];
+        out[o] = acc;
+    }
+    int top[8]; float tv[8]; for (int k = 0; k < 8; k++) { tv[k] = -1e30f; top[k] = -1; }
+    for (int e = 0; e < 256; e++) {
+        for (int k = 0; k < 8; k++) {
+            if (out[e] > tv[k]) {
+                for (int m = 7; m > k; m--) { tv[m] = tv[m-1]; top[m] = top[m-1]; }
+                tv[k] = out[e]; top[k] = e; break;
+            }
+        }
+    }
+    for (int k = 0; k < 8; k++) {
+        if (top[k] < 0) break;
+        for (int role = 0; role < 3; role++) {
+            const int64_t tix = g_lr[j->layer].tix[role];
+            if (tix < 0) continue;
+            moe_pool_prefetch_impl(&g_tp[tix], top[k]);
+        }
+    }
+}
+
+static void * pred_worker(void * arg) {
+    (void) arg;
+    while (1) {
+        int head_i = -1;
+        pthread_mutex_lock(&g_lock);
+        if (g_ring_head > g_ring_tail) head_i = g_ring_tail++;
+        pthread_mutex_unlock(&g_lock);
+        if (head_i < 0) { usleep(200); continue; }
+        pred_do_job(&g_ring[head_i % PRED_RINGSZ]);
+    }
+    return NULL;
+}
+
+// ===================== slot / LRU / queue core (v4) =====================
+
+static void list_unlink(int32_t i) {
+    struct slot_ent * s = &g_slots[i];
+    if (!s->on_list) return;
+    if (s->lru_prev != SLOT_NONE) g_slots[s->lru_prev].lru_next = s->lru_next; else g_lru_head = s->lru_next;
+    if (s->lru_next != SLOT_NONE) g_slots[s->lru_next].lru_prev = s->lru_prev; else g_lru_tail = s->lru_prev;
+    s->lru_prev = s->lru_next = SLOT_NONE; s->on_list = 0;
+}
+static void list_push_back(int32_t i) {
+    struct slot_ent * s = &g_slots[i];
+    if (s->on_list) list_unlink(i);
+    s->lru_prev = g_lru_tail; s->lru_next = SLOT_NONE;
+    if (g_lru_tail != SLOT_NONE) g_slots[g_lru_tail].lru_next = i; else g_lru_head = i;
+    g_lru_tail = i; s->on_list = 1;
+}
+static void account_evict(struct slot_ent * s) {              // same as the engine's account_prefetch_eviction
+    if (s->prefetched && !s->consumed) g_pf_miss++;
+    s->prefetched = 0; s->consumed = 0;
+}
+static int32_t evict_victim_locked(void) {                    // first non-pinned entry at the LRU head (chain contains READY/FAILED only)
+    for (int32_t i = g_lru_head; i != SLOT_NONE; ) {
+        int32_t nxt = g_slots[i].lru_next;
+        if (!g_slots[i].pinned) return i;
+        i = nxt;
+    }
+    return SLOT_NONE;
+}
+static void unclaim_locked(int32_t si) {                      // claim a slot then back out (e.g. queue full)
+    struct slot_ent * s = &g_slots[si];
+    g_tp[s->tix].slot[s->expert] = SLOT_NONE;
+    account_evict(s);
+    s->state = ST_EMPTY; s->expert = -1; s->tix = -1;
+    g_used_slots--;
+}
+// Claim a slot for (tix,e): EMPTY cursor first, then the non-pinned LRU head (READY/FAILED). LOADING is never evictable.
+static int32_t claim_slot_locked(int tix, int32_t e) {
+    int32_t si = SLOT_NONE;
+    for (int t = 0; t < g_nslots; t++) {
+        int32_t i = (g_empty_cursor + t) % g_nslots;
+        if (g_slots[i].state == ST_EMPTY) { si = i; g_empty_cursor = (i + 1) % g_nslots; g_used_slots++; break; }
+    }
+    if (si < 0) {
+        si = evict_victim_locked();
+        if (si < 0) return SLOT_NONE;
+        struct slot_ent * vs = &g_slots[si];
+        g_tp[vs->tix].slot[vs->expert] = SLOT_NONE;
+        if (vs->state == ST_READY) g_evicts++;
+        account_evict(vs);
+        list_unlink(si);
+    }
+    struct slot_ent * s = &g_slots[si];
