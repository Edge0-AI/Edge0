+// bound. Expert tensors are registered into the pool; with E0_BLOB_MB on, each non-expert mmap-view tensor gets one copy-in (isomorphic to the engine's img mirror).
+void llama_model_base::moe_wire(llama_model_loader & ml) {
+    if (!ml.use_mmap || ml.files.empty()) {
+        return;
+    }
+    for (auto & [name, t] : tensors_by_name) {
+        if (!t || !t->data || !strstr(t->name, "exps")) {
+            continue;
+        }
+        const auto * w = ml.get_weight(name.c_str());
+        if (!w || w->idx >= ml.files.size()) {
+            continue;
+        }
+        // pread does not depend on the file cursor, so the loader's fd is safe to use directly (no dup, avoids leaks)
+        moe_pool_register(t, ml.files[w->idx]->file_id(), (uint64_t) w->offs);
+    }
+    if (!moe_pool_blob_enabled()) {
+        return;
+    }
+    size_t blob_copied = 0;
+    for (auto & [name, t] : tensors_by_name) {
+        if (!t || !t->data || strstr(t->name, "exps") || ggml_nbytes(t) == 0) {
+            continue;
+        }
+        bool in_mapping = false;
+        for (const auto & mapping : pimpl->mappings) {
+            const uint8_t * lo = (const uint8_t *) mapping->addr();
+            const uint8_t * hi = lo + mapping->size();
+            const uint8_t * p  = (const uint8_t *) t->data;
+            if (p >= lo && p < hi) {
+                in_mapping = true;
+                break;
             }
         }
+        if (!in_mapping) {
+            continue;   // heap tensors (already converted/copied) are resident anyway -- leave them alone
+        }
+        void * dst = moe_pool_blob_add(ggml_nbytes(t));
+        if (!dst) {
+            continue;   // budget exhausted: stay in mmap (visible as blob_mb in the dump)
+        }
+        memcpy(dst, t->data, ggml_nbytes(t));
+        t->data = dst;
+        blob_copied += ggml_nbytes(t);
     }
