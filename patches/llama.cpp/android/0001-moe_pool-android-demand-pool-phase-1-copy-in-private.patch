diff --git a/ggml/src/ggml-cpu/moe_pool.c b/ggml/src/ggml-cpu/moe_pool.c
new file mode 100644
index 0000000..2f75ab1
--- /dev/null
+++ b/ggml/src/ggml-cpu/moe_pool.c
@@ -0,0 +1,188 @@
+// moe_pool.c -- expert demand pool (Android phase 1, edge0/android-pool; no prediction, synchronous bulk reads).
+// Design = copy-in private frames + lazy row-pointer resolution: a hit = zero-fault direct read of the private frame; a miss =
+// thread0 preads the whole block before the ggml_barrier ("wholesale"); eviction = pool-managed LRU (whole-expert granularity).
+// Concurrency protocol (the premise phase 1 holds on; server parallel ctx is a phase-2 topic):
+//   the ggml-cpu thread pool barriers at EVERY graph-node boundary; ensure runs only on thread0 at the mul_mat_id entry,
+//   before the global barrier -> all readers are quiescent when writing; cross-ctx parallel decode is unguarded (documented red line).
+// Experts outside the pool / that don't fit: resident_slot=-1 -> the caller gets the default pointer and falls back to the original mmap (kernel backstop).
+// env: E0_POOL_MB (0/unset = off, zero disturbance).
+#include "moe_pool.h"
+#include "ggml.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#define MOE_POOL_MAX_TENSORS 192   // 40 layers x3 (gate/up/down) = 120 @35b; headroom kept
+
+struct slot_ent {
+    char *   base;           // arena private frame
+    int32_t  expert;         // -1 = free
+    int32_t  tix;
+    uint64_t last_gen;
+    size_t   bytes;
+    struct slot_ent * prev, * next;
+};
+
+struct tensor_pool {
+    const void * key;                // src0->data is stable after load; used as identity
+    int      fd;
+    uint64_t file_off;
+    size_t   slice;                  // private-frame size (page-aligned, >= stride)
+    size_t   stride;                 // per-expert step within the file
+    int64_t  n_experts;
+    int64_t * slot_of;               // [n_experts] slot index or -1 (no tearing concern under the quiesce protocol)
+    long long hits, misses;
+};
+
+static pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;
+static size_t   g_cap, g_used;
+static char *   g_arena;
+static size_t   g_bump;
+static uint64_t g_gen;
+static struct tensor_pool g_tp[MOE_POOL_MAX_TENSORS];
+static int      g_ntp;
+static struct slot_ent ** g_slots; static int g_nslots, g_slotcap;
+static struct slot_ent * g_lru_head, * g_lru_tail;
+static int      g_ready;
+static long long g_loads, g_evicts, g_bytes_loaded;
+
+static size_t align_up(size_t x) { return (x + 4095) & ~(size_t)4095; }
+
+void moe_pool_init(void) {
+    if (g_ready) return;
+    const char * e = getenv("E0_POOL_MB");
+    size_t mb = e ? (size_t) atol(e) : 0;
+    if (!mb) return;
+    g_cap = mb * 1024 * 1024;
+    void * m = mmap(NULL, g_cap, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (m == MAP_FAILED) return;
+    g_arena = m; g_ready = 1;
+}
+
+int moe_pool_enabled(void) { return g_ready; }
+static struct tensor_pool * find_tp(const struct ggml_tensor * t);
+
+void moe_pool_register(struct ggml_tensor * t, int fd, uint64_t file_off) {
+    if (!g_ready) return;
+    if (t->ne[2] < 8) return;                       // expert-stack shape
+    if (find_tp(t)) return;                                 // idempotent: same pointer never re-registered
+    const size_t total = (size_t) ggml_nbytes(t);
+    const size_t stride = total / (size_t) t->ne[2];
+    // conservative gate: pool only when the expert slice is naturally page-aligned (holds for this artifact); otherwise leave it to the kernel
+    if (stride % 4096) return;
+    const size_t slice = stride;
+    pthread_mutex_lock(&g_lock);
+    if (g_ntp >= MOE_POOL_MAX_TENSORS) { pthread_mutex_unlock(&g_lock); return; }
+    struct tensor_pool * p = &g_tp[g_ntp++];
+    p->key = t->data; p->fd = fd; p->file_off = file_off; p->slice = slice; p->stride = stride;
+    p->n_experts = t->ne[2];
+    p->slot_of = calloc(p->n_experts, sizeof(int64_t));
+    for (int64_t i = 0; i < p->n_experts; i++) p->slot_of[i] = -1;
+    pthread_mutex_unlock(&g_lock);
+}
+
+static struct tensor_pool * find_tp(const struct ggml_tensor * t) {
+    for (int i = 0; i < g_ntp; i++) if (g_tp[i].key == t->data) return &g_tp[i];
+    return NULL;
+}
+
+int moe_pool_pooled(const struct ggml_tensor * t) {
+    if (!g_ready || !t || !t->data) return 0;
+    return find_tp(t) != NULL;
+}
+
+// ---- LRU ----
+static void lru_unlink(struct slot_ent * s) {
+    if (s->prev) s->prev->next = s->next; else g_lru_head = s->next;
+    if (s->next) s->next->prev = s->prev; else g_lru_tail = s->prev;
+    s->prev = s->next = NULL;
+}
+static void lru_front(struct slot_ent * s) {
+    s->prev = NULL; s->next = g_lru_head;
+    if (g_lru_head) g_lru_head->prev = s; else g_lru_tail = s;
+    g_lru_head = s;
+}
+
+static struct slot_ent * slot_alloc(size_t bytes, int tix) {
+    struct slot_ent * s = NULL;
+    for (int i = 0; i < g_nslots; i++) {                       // first pick a free slot of the same size
+        if (g_slots[i]->expert == -1 && g_slots[i]->bytes == bytes) { s = g_slots[i]; break; }
+    }
+    if (!s && g_bump + bytes <= g_cap) {                       // then bump-allocate
+        s = calloc(1, sizeof(*s));
+        s->base = g_arena + g_bump; g_bump += bytes; s->bytes = bytes;
+        if (g_nslots == g_slotcap) {
+            g_slotcap = g_slotcap ? g_slotcap * 2 : 512;
+            g_slots = realloc(g_slots, (size_t) g_slotcap * sizeof(*g_slots));
+        }
+        g_slots[g_nslots++] = s;
+    }
+    if (!s) {                                                   // finally evict an older-generation LRU entry
+        for (struct slot_ent * c = g_lru_tail; c; c = c->prev) {
+            if (c->expert < 0 || c->last_gen == g_gen) continue;
+            g_tp[c->tix].slot_of[c->expert] = -1;
+            g_used -= c->bytes;
+            s = c; break;
+        }
+        if (s) { g_evicts++; }
+    }
+    if (!s) return NULL;                                        // pool full this generation / huge block: kernel backstop
+    if (s->expert >= 0) lru_unlink(s);
+    s->tix = tix; s->expert = -1;
+    g_used += s->bytes;
+    return s;
+}
+
+void moe_pool_ensure(const struct ggml_tensor * t, const int32_t * ids, int n_ids) {
+    if (!g_ready) return;
+    pthread_mutex_lock(&g_lock);
+    g_gen++;
+    struct tensor_pool * p = find_tp(t);
+    if (!p) { pthread_mutex_unlock(&g_lock); return; }
+    const int tix = (int) (p - g_tp);
+    for (int i = 0; i < n_ids; i++) {
+        const int32_t e = ids[i];
+        if (e < 0 || e >= p->n_experts) continue;
+        if (p->slot_of[e] >= 0) {                               // hit (slot_of = slot_ent address)
+            p->hits++;
+            struct slot_ent * s = (struct slot_ent *) p->slot_of[e];
+            if (s->last_gen != g_gen) { lru_unlink(s); lru_front(s); s->last_gen = g_gen; }
+            continue;
+        }
+        p->misses++;
+        struct slot_ent * s = slot_alloc(p->slice, tix);
+        if (!s) break;
+        const off_t off = (off_t) (p->file_off + (uint64_t) e * p->stride);
+        const ssize_t got = pread(p->fd, s->base, p->slice, off);
+        if (got != (ssize_t) p->slice) { s->expert = -1; break; }
+        s->expert = e; s->last_gen = g_gen;
+        lru_front(s);
+        g_loads++; g_bytes_loaded += got;
+        p->slot_of[e] = (int64_t) (intptr_t) s;
+    }
+    pthread_mutex_unlock(&g_lock);
+}
+
+const void * moe_pool_row_ptr(const struct ggml_tensor * t, int64_t expert, const void * def) {
+    if (!g_ready || expert < 0) return def;
+    const struct tensor_pool * p = find_tp(t);
+    if (!p || expert >= p->n_experts) return def;
+    const int64_t si = p->slot_of[expert];
+    if (si < 0) return def;
+    const struct slot_ent * s = (const struct slot_ent *) si;
+    return (s->expert == expert) ? s->base : def;               // always true under the quiesce protocol; kept as a defensive check
+}
+
+void moe_pool_stats(long long * hits, long long * misses, long long * loads, long long * evicts,
+                    long long * bytes_loaded, size_t * cap_bytes, size_t * used_bytes) {
+    long long h = 0, m = 0;
+    for (int i = 0; i < g_ntp; i++) { h += g_tp[i].hits; m += g_tp[i].misses; }
+    if (hits) *hits = h; if (misses) *misses = m;
+    if (loads) *loads = g_loads; if (evicts) *evicts = g_evicts;
+    if (bytes_loaded) *bytes_loaded = g_bytes_loaded;
+    if (cap_bytes) *cap_bytes = g_cap; if (used_bytes) *used_bytes = g_used;
+}
diff --git a/ggml/src/ggml-cpu/moe_pool.h b/ggml/src/ggml-cpu/moe_pool.h
new file mode 100644
index 0000000..ab9f7a1
--- /dev/null
+++ b/ggml/src/ggml-cpu/moe_pool.h
@@ -0,0 +1,40 @@
+// moe_pool.h -- expert demand pool (Android phase 1, no prediction; fork edge0/android-pool).
+// Foundation = copy-in private frames (Android mlock RLIMIT=64KB is hard-wired; the pin-file-page design is unusable -- see PROBE B-track closure).
+// hit = zero-fault direct read of private memory; miss = ensure() bulk preads the whole block ("wholesale" ~1GB/s vs page-fault "retail" 16MB/s);
+// eviction = this pool's own LRU (whole-expert granularity, never half an expert); long-tail experts outside the pool fall back to their original mmap pages, kernel-backed (lazy pointer resolution).
+#ifndef MOE_POOL_H
+#define MOE_POOL_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ggml_tensor;
+
+// called from the llama side before the first registration; E0_POOL_MB unset/0 -> never ready (zero disturbance to current behavior)
+void moe_pool_init(void);
+int moe_pool_enabled(void);
+
+// load-time registration: t = expert 3D tensor (src0), file_off = t's data offset in the model file, fd = file descriptor
+void moe_pool_register(struct ggml_tensor * t, int fd, uint64_t file_off);
+
+// query: is this tensor pool-managed (used to turn off the IQP/repack bypass)
+int moe_pool_pooled(const struct ggml_tensor * t);
+
+// thread0 only (before the barrier): bulk-read the experts named by the ids tensor into the pool (LRU makes room)
+void moe_pool_ensure(const struct ggml_tensor * t, const int32_t * ids, int n_ids);
+
+// row-base resolution: resident -> private-frame pointer; otherwise -> default_ptr (original mmap address, kernel backstop)
+const void * moe_pool_row_ptr(const struct ggml_tensor * t, int64_t expert, const void * default_ptr);
+
+// stats snapshot (for debugging / accounting)
+void moe_pool_stats(long long * hits, long long * misses, long long * loads, long long * evicts,
+                    long long * bytes_loaded, size_t * cap_bytes, size_t * used_bytes);
+
+#ifdef __cplusplus
+}
+#endif
+#endif // MOE_POOL_H
