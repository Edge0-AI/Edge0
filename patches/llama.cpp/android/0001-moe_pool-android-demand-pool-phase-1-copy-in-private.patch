+// moe_pool in-place declarations (same convention as fork edge0/prefetch.cc; implementation in ggml-cpu/moe_pool.c, linked into the same libllama)
+extern "C" {
+void        moe_pool_init(void);
+int         moe_pool_enabled(void);
