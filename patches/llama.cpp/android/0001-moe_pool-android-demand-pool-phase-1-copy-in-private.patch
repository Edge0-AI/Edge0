+}
 #include "llama-model.h"
 
 #include "llama-arch.h"
@@ -1441,7 +1451,7 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
 
     this->ml = &ml; // to be used by create_tensor() and load_arch_tensors()
 
-    if (ml.use_mmap && params.load_mode == LLAMA_LOAD_MODE_AUTO) {
+    if (ml.use_mmap && params.load_mode == LLAMA_LOAD_MODE_AUTO && !getenv("E0_MMAP_NOPREFETCH")) {
         for (const auto & dev : devices) {
             ggml_backend_dev_props props;
             ggml_backend_dev_get_props(dev.dev, &props);
@@ -1731,7 +1741,9 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
         }
     }
 
-    ml.init_mappings(true, use_mlock ? &pimpl->mlock_mmaps : nullptr);
+    // android gate (exp/llama-gguf-perf): E0_MMAP_NOPREFETCH=1 skips whole-file WILLNEED
+    const bool mmap_prefetch = !use_mlock && getenv("E0_MMAP_NOPREFETCH") == nullptr;
+    ml.init_mappings(mmap_prefetch, use_mlock ? &pimpl->mlock_mmaps : nullptr);
     pimpl->mappings.reserve(ml.mappings.size());
 
     // create the backend buffers
@@ -1879,6 +1891,27 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
         }
     }
 
+    // moe_pool registration (Android phase 1): expert 3D tensors -> pool. With E0_POOL_MB unset this block has no side effects.
+    moe_pool_init();
+    if (moe_pool_enabled() && ml.use_mmap && !ml.files.empty()) {
+        auto reg = [&](ggml_tensor * t) {
+            if (!t || !strstr(t->name, "exps")) {
+                return;
+            }
+            const auto * w = ml.get_weight(t->name);
+            if (!w || w->idx >= ml.files.size()) {
+                return;
+            }
+            // pread does not depend on the file cursor, so the loader's fd is safe to use directly (no dup, avoids leaks)
+            moe_pool_register(t, ml.files[w->idx]->file_id(), (uint64_t) w->offs);
+        };
+        for (auto & ctx : ml.contexts) {
+            for (ggml_tensor * t = ggml_get_first_tensor(ctx.get()); t; t = ggml_get_next_tensor(ctx.get(), t)) {
+                reg(t);
+            }
+        }
+    }
+
     return true;
 }
 
