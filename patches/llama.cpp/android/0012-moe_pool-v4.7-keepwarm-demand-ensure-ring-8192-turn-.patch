diff --git a/ggml/src/ggml-cpu/moe_pool.c b/ggml/src/ggml-cpu/moe_pool.c
index e9d3415..2098376 100644
--- a/ggml/src/ggml-cpu/moe_pool.c
+++ b/ggml/src/ggml-cpu/moe_pool.c
@@ -91,6 +91,12 @@ static long long g_pf_issued, g_pf_used, g_pf_waste, g_pf_drop, g_pf_miss, g_res
 static char *   g_blob; static size_t g_blob_cap, g_blob_bump; static int g_blob_on;
 static volatile int g_heads_on, g_pred_enabled;   // referenced early by init (defined in the pred section)
 
+// keepwarm (9/29 20s-between-turns case): accounts the (tix,e) touched by the current decode round; at turn end, evicted entries are refilled asynchronously when idle.
+#define KW_DEPTH 8192
+static struct { int32_t tix; int32_t e; } g_kw[KW_DEPTH];
+static unsigned g_kwh, g_kwt;
+static volatile int g_kw_busy;
+
 static uint64_t now_ns(void) {
     struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
     return (uint64_t) ts.tv_sec * 1000000000ull + (uint64_t) ts.tv_nsec;
@@ -258,8 +264,15 @@ static float dot_f16_f32(const uint16_t * w, const float * x, int n) {
 #endif
 static inline float gelu_erf_f(float x) { return 0.5f * x * (1.0f + erff(x * 0.70710678118654752440f)); }
 
+static void moe_pool_f16_quant_feats(float * x, int n) {
+    for (int i = 0; i < n; i++) x[i] = (float) (__fp16) x[i];
+}
+
 static void pred_do_job(struct pred_job * j) {
     float h[512], out[256];
+    // SPEC sec.1: feats are cast to f16 before entering the network (training distribution = f16; feeding f32 directly would
+    // drift the top-K ranking on near-ties -- prime suspect #1 for the gap between the 10% pf hit rate and the 55% recorded profile).
+    { extern void moe_pool_f16_quant_feats(float * x, int n); moe_pool_f16_quant_feats(j->x, 2560); }
     const uint16_t * fc1 = g_lr[j->layer].hd.fc1;
     const uint16_t * fc2 = g_lr[j->layer].hd.fc2;
     const uint16_t * lin = g_lr[j->layer].hd.lin;
@@ -595,6 +608,7 @@ void moe_pool_ensure(const struct ggml_tensor * t, const int32_t * ids, int n_id
             struct slot_ent * s = &g_slots[si];
             if (s->state == ST_READY) {
                 p->hits++;
+                { unsigned h = g_kwh % KW_DEPTH; g_kw[h].tix = tix; g_kw[h].e = e; g_kwh++; }
                 if (s->prefetched && !s->consumed) { g_pf_used++; s->consumed = 1; }
                 list_push_back(si);
                 pin_locked(si);
@@ -629,6 +643,7 @@ void moe_pool_ensure(const struct ggml_tensor * t, const int32_t * ids, int n_id
             pthread_cond_wait(&g_scv, &g_lock);
         }
         if (slot < 0) continue;
+        { unsigned h = g_kwh % KW_DEPTH; g_kw[h].tix = tix; g_kw[h].e = e; g_kwh++; }
         pin_locked(slot);
         if (enqueue_io_locked(slot, 1)) {
             if (nwait < 64) waiters[nwait++] = slot;
@@ -676,6 +691,38 @@ void moe_pool_prefetch_impl(struct tensor_pool * p, int64_t e) {
     pthread_mutex_unlock(&g_lock);
 }
 
+// turn-end refill: move (tix,e) pairs in the ring that are currently not in the pool back at prefetch level
+// (demand=0 queue, evictable). budget_mb=0 -> read E0_KEEPWARM_MB (default 256MB, low intensity, never competes with the foreground).
+void moe_pool_keepwarm(int budget_mb) {
+    if (!g_ready) return;
+    if (budget_mb <= 0) {
+        const char * e = getenv("E0_KEEPWARM_MB");
+        budget_mb = e ? (int) atol(e) : 0;
+        if (budget_mb <= 0) budget_mb = 256;
+    }
+    if (g_kw_busy) return;
+    g_kw_busy = 1;
+    long long bytes = (long long) budget_mb * 1024 * 1024;
+    pthread_mutex_lock(&g_lock);
+    unsigned seen_end = g_kwh;
+    for (unsigned i = g_kwt; i < seen_end && bytes > 0; i++) {
+        int k = i % KW_DEPTH;
+        const int tix = g_kw[k].tix; const int32_t e2 = g_kw[k].e;
+        if (tix < 0 || tix >= g_ntp) continue;
+        struct tensor_pool * p = &g_tp[tix];
+        if (e2 < 0 || e2 >= p->n_experts) continue;
+        if (p->slot[e2] >= 0) continue;                     // already resident
+        const int32_t slot = claim_slot_locked(tix, e2);
+        if (slot < 0) break;
+        g_slots[slot].prefetched = 1;
+        if (!enqueue_io_locked(slot, 0)) { unclaim_locked(slot); break; }
+        bytes -= (long long) p->slice;
+    }
+    g_kwt = seen_end;                                       // consumed this round (whether or not fully refilled)
+    pthread_mutex_unlock(&g_lock);
+    g_kw_busy = 0;
+}
+
 const void * moe_pool_row_ptr(const struct ggml_tensor * t, int64_t expert, const void * def) {
     if (!g_ready || expert < 0) return def;
     const struct tensor_pool * p = find_tp(t);
