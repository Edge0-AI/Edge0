# Build identity: the source commit and whether the source tree had uncommitted changes.
#
# Two roles in one file:
#   * included from the root CMakeLists.txt: defines the always-run target moe_build_identity;
#   * run as a script (cmake -DSOURCE_DIR=<dir> -DOUTPUT=<file> -P BuildIdentity.cmake):
#     writes the generated header, and leaves the file untouched when its content is unchanged.
#
# Values: MOE_BUILD_SOURCE_MODIFIED is 0 (clean), 1 (uncommitted changes, untracked files included)
# or 2 (unknown, MOE_BUILD_SOURCE_REASON says why). The source tree may be the top level of a Git
# work tree (a clone or a submodule) or a tracked subdirectory of one (the engine published inside a
# larger repository); the commit is then that work tree's HEAD and only changes inside the source
# tree count. A missing Git or a source tree that Git does not track never fails the build.

if(CMAKE_SCRIPT_MODE_FILE)
    set(commit "")
    set(modified 2)
    set(reason "")
    find_program(MOE_GIT_EXECUTABLE git)
    if(NOT MOE_GIT_EXECUTABLE)
        set(reason "git executable not found")
    else()
        execute_process(COMMAND "${MOE_GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --show-toplevel
            RESULT_VARIABLE top_result OUTPUT_VARIABLE top_out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        # A directory that merely lies inside some other work tree, untracked, must not report that
        # work tree's commit: require Git to track files under the source tree.
        set(tracked_out "")
        if(top_result EQUAL 0)
            execute_process(COMMAND "${MOE_GIT_EXECUTABLE}" -C "${SOURCE_DIR}" ls-files -- .
                RESULT_VARIABLE tracked_result OUTPUT_VARIABLE tracked_out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        endif()
        if(NOT top_result EQUAL 0)
            set(reason "source tree is not inside a Git work tree")
        elseif(tracked_out STREQUAL "")
            set(reason "source tree is not tracked by its enclosing Git work tree")
        else()
            execute_process(COMMAND "${MOE_GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse HEAD
                RESULT_VARIABLE head_result OUTPUT_VARIABLE head_out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            execute_process(COMMAND "${MOE_GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=normal -- .
                RESULT_VARIABLE status_result OUTPUT_VARIABLE status_out ERROR_QUIET)
            if(NOT head_result EQUAL 0 OR NOT head_out MATCHES "^[0-9a-f]+$")
                set(reason "git rev-parse HEAD failed")
            elseif(NOT status_result EQUAL 0)
                set(commit "${head_out}")
                set(reason "git status failed")
            else()
                set(commit "${head_out}")
                if(status_out STREQUAL "")
                    set(modified 0)
                else()
                    set(modified 1)
                endif()
            endif()
        endif()
    endif()
    string(CONCAT content "// Generated by cmake/BuildIdentity.cmake on every build. Do not edit.\n#pragma once\n"
        "#define MOE_BUILD_SOURCE_COMMIT \"${commit}\"\n"
        "#define MOE_BUILD_SOURCE_MODIFIED ${modified}\n"
        "#define MOE_BUILD_SOURCE_REASON \"${reason}\"\n")
    set(existing "")
    if(EXISTS "${OUTPUT}")
        file(READ "${OUTPUT}" existing)
    endif()
    if(NOT existing STREQUAL content)
        get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
        file(MAKE_DIRECTORY "${output_dir}")
        file(WRITE "${OUTPUT}" "${content}")
    endif()
else()
    set(MOE_BUILD_IDENTITY_HEADER "${PROJECT_BINARY_DIR}/generated/edge0/build_identity.h")
    add_custom_target(moe_build_identity ALL
        COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${PROJECT_SOURCE_DIR}" "-DOUTPUT=${MOE_BUILD_IDENTITY_HEADER}"
            -P "${CMAKE_CURRENT_LIST_FILE}"
        BYPRODUCTS "${MOE_BUILD_IDENTITY_HEADER}"
        COMMENT "Refreshing build identity"
        VERBATIM)
endif()
